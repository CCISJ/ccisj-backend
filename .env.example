# Copiar este archivo como `.env` y completar los valores.
# El `.env` NO se sube al repositorio.

# Puerto donde queda escuchando el backend.
PORT=3000

# Cadena de conexión de PostgreSQL (Supabase).
# En desarrollo usamos la conexión "Session Pooler", que se copia desde:
#   Supabase -> Project Settings -> Database -> Connection string -> Session pooler
#
# Formato:
# DB_URL=postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres
DB_URL=

# Secreto con el que se firman los JWT del login.
# Cualquier cadena larga y aleatoria sirve; no hace falta que coincida con la
# de otro integrante del equipo, pero sí tiene que estar presente: sin ella
# el login y las rutas protegidas devuelven error.
JWT_SECRET=
