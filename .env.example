# Copiar este archivo como `.env` y completar los valores.
# El `.env` NO se sube al repositorio.

# Puerto donde queda escuchando el backend.
PORT=3000

# Cadena de conexión de PostgreSQL (Supabase).
# En desarrollo usamos la conexión "Session Pooler", que se copia desde:
#   Supabase -> Project Settings -> Database -> Connection string -> Session pooler
#
# Formato:
# DB_URL=postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres
DB_URL=

# Secreto con el que se firman los JWT del login.
# No hace falta que coincida con la de otro integrante del equipo, pero sí
# tiene que estar presente y tener al menos 32 caracteres: uno corto se rompe
# por fuerza bruta y deja de proteger la firma. Sin ella, o demasiado corta,
# el servidor NO arranca (antes arrancaba y fallaba con cada request).
#
# Para generar una:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Orígenes que pueden llamar a la API con la cookie de sesión, separados por
# coma. Si se deja vacío, se permite solo el frontend de desarrollo
# (http://localhost:5173).
CORS_ORIGIN=

# --- Opcionales: si se dejan vacías se usan estos mismos valores ---

# Tamaño máximo del cuerpo de un request (JSON). Formato: 100kb, 1mb, 512b.
# Es el límite que ya aplicaba Express por omisión; está acá para que sea una
# decisión visible y se pueda ajustar sin tocar código.
BODY_LIMIT=100kb

# Cuántos proxies hay delante de la aplicación (Nginx, Render, Railway).
# Importa para el rate limit: detrás de un proxy, sin esto, todos los requests
# parecen venir de la misma IP y el límite deja de distinguir usuarios. Pero
# ponerlo SIN un proxy delante es peor, porque habilita a cualquiera a
# falsificar X-Forwarded-For y evadir el límite.
#
# Dejar vacío o "false" corriendo en local. En un despliegue, la cantidad de
# saltos (normalmente "1"). "true" también se acepta, pero confía en toda la
# cadena de la cabecera, así que es la opción menos segura.
TRUST_PROXY=false
