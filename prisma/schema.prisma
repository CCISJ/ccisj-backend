generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoOferta {
  ACTIVA
  CERRADA

  @@map("estado_oferta")
}

enum EstadoPostulacion {
  ENVIADA
  EN_REVISION
  SELECCIONADO
  NO_SELECCIONADO
  FINALIZADA

  @@map("estado_postulacion")
}

enum TipoSocio {
  COMUN
  DIRECTIVO

  @@map("tipo_socio")
}

enum TipoUsuario {
  ADMIN
  POSTULANTE
  SOCIO

  @@map("tipo_usuario")
}

enum TipoNotificacion {
  NORMAL
  EMERGENTE

  @@map("tipo_notificacion")
}

enum TipoAjusteCuota {
  ADICIONAL
  DESCUENTO

  @@map("tipo_ajuste_cuota")
}

enum EstadoCuota {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA

  @@map("estado_cuota")
}

model Usuario {
  id                  Int         @id @default(autoincrement())
  email               String      @unique @db.VarChar(255)
  password            String      @db.VarChar(255)
  tipo                TipoUsuario @map("tipo")
  activo              Boolean     @default(true)
  fechaCreacion       DateTime    @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  passwordActualizada DateTime?   @map("password_actualizada") @db.Timestamp(6)

  ofertas    Oferta[]
  postulante Postulante?
  socio      Socio?

  notificacionesCreadas   Notificacion[]        @relation("NotificacionCreadaPor")
  notificacionesRecibidas NotificacionUsuario[]
  pagoCuotas              PagoCuota[]

  @@map("usuario")
}

model Notificacion {
  id            Int              @id @default(autoincrement())
  titulo        String           @db.VarChar(150)
  mensaje       String
  tipo          TipoNotificacion @default(NORMAL)
  fechaCreacion DateTime         @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  activa        Boolean          @default(true)

  creadoPorId Int     @map("creado_por_id")
  creadoPor   Usuario @relation("NotificacionCreadaPor", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  destinatarios NotificacionUsuario[]

  @@map("notificacion")
}

model NotificacionUsuario {
  id                  Int       @id @default(autoincrement())
  notificacionId      Int       @map("notificacion_id")
  usuarioId           Int       @map("usuario_id")
  leida               Boolean   @default(false)
  fechaLectura        DateTime? @map("fecha_lectura") @db.Timestamp(6)
  emergenteVista      Boolean   @default(false) @map("emergente_vista")
  fechaEmergenteVista DateTime? @map("fecha_emergente_vista") @db.Timestamp(6)

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([notificacionId, usuarioId])
  @@map("notificacion_usuario")
}

model Socio {
  id        Int @id @default(autoincrement())
  usuarioId Int @unique

  razonSocial   String
  titular       String
  giroComercial String
  tipo          TipoSocio

  rut       String @unique
  numeroBps String @unique

  fechaInicioEmpresa DateTime
  fechaAfiliacion    DateTime

  direccion String
  ciudad    String

  celular  String
  telefono String
  email    String

  observaciones String?

  ajustesCuota AjusteCuotaSocio[]
  cuotas       Cuota[]
  pagosCuota   PagoCuota[]

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  ofertas Oferta[]
}

model Postulante {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  nombre    String  @db.VarChar(100)
  apellido  String  @db.VarChar(100)
  telefono  String? @db.VarChar(50)

  usuario       Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_postulante_usuario")
  cvs           Cv[]
  postulaciones Postulacion[]

  @@map("postulante")
}

model Cv {
  id                 Int      @id @default(autoincrement())
  postulanteId       Int      @map("postulante_id")
  archivoUrl         String?  @map("archivo_url") @db.VarChar(500)
  descripcion        String?
  fechaActualizacion DateTime @default(now()) @map("fecha_actualizacion") @db.Timestamp(6)

  postulante Postulante @relation(fields: [postulanteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cv_postulante")

  @@map("cv")
}

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)
  activa      Boolean @default(true)

  ofertas OfertaCategoria[]

  @@map("categoria")
}

model Oferta {
  id               Int          @id @default(autoincrement())
  socioId          Int          @map("socio_id")
  creadaPor        Int          @map("creada_por")
  titulo           String       @db.VarChar(255)
  descripcion      String
  ubicacion        String?      @db.VarChar(255)
  modalidad        String?      @db.VarChar(100)
  cantidadVacantes Int          @default(1) @map("cantidad_vacantes")
  fechaPublicacion DateTime     @default(now()) @map("fecha_publicacion") @db.Timestamp(6)
  fechaCierre      DateTime?    @map("fecha_cierre") @db.Timestamp(6)
  estado           EstadoOferta @default(ACTIVA)

  creador       Usuario           @relation(fields: [creadaPor], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_oferta_creador")
  socio         Socio             @relation(fields: [socioId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_oferta_socio")
  categorias    OfertaCategoria[]
  postulaciones Postulacion[]

  @@map("oferta")
}

model OfertaCategoria {
  ofertaId    Int @map("oferta_id")
  categoriaId Int @map("categoria_id")

  oferta    Oferta    @relation(fields: [ofertaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_oferta_categoria_oferta")
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_oferta_categoria_categoria")

  @@id([ofertaId, categoriaId])
  @@map("oferta_categoria")
}

model Postulacion {
  id               Int               @id @default(autoincrement())
  ofertaId         Int               @map("oferta_id")
  postulanteId     Int               @map("postulante_id")
  fechaPostulacion DateTime          @default(now()) @map("fecha_postulacion") @db.Timestamp(6)
  estado           EstadoPostulacion @default(ENVIADA)
  observaciones    String?

  oferta     Oferta     @relation(fields: [ofertaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_postulacion_oferta")
  postulante Postulante @relation(fields: [postulanteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_postulacion_postulante")

  @@unique([ofertaId, postulanteId], map: "uq_postulacion")
  @@map("postulacion")
}

model ConfiguracionCuota {
  id            Int      @id @default(autoincrement())
  importeBase   Decimal  @map("importe_base") @db.Decimal(10, 2)
  vigenciaDesde DateTime @unique @map("vigencia_desde") @db.Date
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  @@map("configuracion_cuota")
}

model AjusteCuotaSocio {
  id            Int             @id @default(autoincrement())
  socioId       Int             @map("socio_id")
  tipo          TipoAjusteCuota
  importe       Decimal         @db.Decimal(10, 2)
  fechaDesde    DateTime        @map("fecha_desde") @db.Date
  fechaHasta    DateTime?       @map("fecha_hasta") @db.Date
  motivo        String?         @db.VarChar(255)
  activo        Boolean         @default(true)
  fechaCreacion DateTime        @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  socio Socio @relation(fields: [socioId], references: [id], onDelete: NoAction)

  @@map("ajuste_cuota_socio")
}

model Cuota {
  id               Int      @id @default(autoincrement())
  socioId          Int      @map("socio_id")
  periodoDesde     DateTime @map("periodo_desde") @db.Date
  periodoHasta     DateTime @map("periodo_hasta") @db.Date
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date

  importeBase    Decimal @map("importe_base") @db.Decimal(10, 2)
  importeAjustes Decimal @default(0) @map("importe_ajustes") @db.Decimal(10, 2)
  importeTotal   Decimal @map("importe_total") @db.Decimal(10, 2)

  estado        EstadoCuota @default(PENDIENTE)
  fechaCreacion DateTime    @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  socio Socio              @relation(fields: [socioId], references: [id], onDelete: NoAction)
  pagos PagoCuotaDetalle[]

  @@unique([socioId, periodoDesde])
  @@map("cuota")
}

model PagoCuota {
  id              Int @id @default(autoincrement())
  socioId         Int @map("socio_id")
  registradoPorId Int @map("registrado_por_id")

  importe   Decimal  @db.Decimal(10, 2)
  fechaPago DateTime @map("fecha_pago") @db.Timestamp(6)

  medioPago     String  @map("medio_pago") @db.VarChar(50)
  numeroRecibo  String? @map("numero_recibo") @db.VarChar(100)
  observaciones String? @db.VarChar(500)

  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamp(6)

  socio         Socio              @relation(fields: [socioId], references: [id], onDelete: NoAction)
  registradoPor Usuario            @relation(fields: [registradoPorId], references: [id], onDelete: NoAction)
  detalles      PagoCuotaDetalle[]

  @@map("pago_cuota")
}

model PagoCuotaDetalle {
  id              Int     @id @default(autoincrement())
  pagoId          Int     @map("pago_id")
  cuotaId         Int     @map("cuota_id")
  importeAplicado Decimal @map("importe_aplicado") @db.Decimal(10, 2)

  pago  PagoCuota @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  cuota Cuota     @relation(fields: [cuotaId], references: [id], onDelete: NoAction)

  @@unique([pagoId, cuotaId])
  @@map("pago_cuota_detalle")
}
